{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@types/dom-webcodecs", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "kenburnz": ["../src/index.ts"],
      "kenburnz/component": ["../src/component/index.ts"],
      "kenburnz/vanilla": ["../src/component/vanilla.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
